#!/bin/sh
# run once after cloning: wires the git hooks, makes the python environment, and
# checks the toolchain the build and the checks need.
set -eu

# the python environment lives in the main checkout, where any linked worktree can share it
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
cd "$root"

git config core.hooksPath .githooks
echo "hooks: core.hooksPath = .githooks"

if command -v uv >/dev/null 2>&1; then
	# .python-version names the python ci runs; rebuild the environment if it drifted
	want=$(cat .python-version)
	if [ -x .venv/bin/python ] && ! .venv/bin/python --version | grep -q "Python $want"; then
		echo "python: .venv is $(.venv/bin/python --version), want $want; rebuilding"
		rm -rf .venv
	fi
	[ -x .venv/bin/python ] || uv venv -q --python "$want" .venv
	uv pip install -q --python .venv/bin/python -r requirements-dev.txt
	echo "python: .venv ready ($(.venv/bin/python --version); ruff, shellcheck, shfmt pinned in requirements-dev.txt)"
else
	echo "python: uv not found; install it, or make a python $(cat .python-version) environment from requirements-dev.txt" >&2
fi

missing=0
for tool in nasm ndisasm qemu-system-i386 node npm gh; do
	if command -v "$tool" >/dev/null 2>&1; then
		echo "tool: $tool ok"
	else
		echo "tool: $tool MISSING" >&2
		missing=1
	fi
done
for tool in ffmpeg gdb; do
	if command -v "$tool" >/dev/null 2>&1; then
		echo "tool: $tool ok"
	else
		echo "tool: $tool not found (optional: verify uses ffmpeg when present; make demo needs it and gdb)"
	fi
done
if [ "$missing" != 0 ]; then
	echo "setup: install the missing tools (macos: brew install nasm qemu node gh)" >&2
	exit 1
fi
echo "setup: done"
