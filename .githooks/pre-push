#!/bin/sh
# the default branch advances only through a merged pull request. anything else
# pushed must pass the full check first.
set -eu

remote=$1
default=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null | sed "s|^$remote/||")
[ -n "$default" ] || default=main

run_check=0
while read -r _ local_sha remote_ref _; do
	if [ "$remote_ref" = "refs/heads/$default" ]; then
		# the one exception: the very first push, which creates the default branch
		if ! git ls-remote --exit-code --heads "$remote" "$default" >/dev/null 2>&1; then
			continue
		fi
		echo "pre-push: $default advances only through a merged pull request (open a pull request)" >&2
		exit 1
	fi
	case "$local_sha" in *[!0]*) run_check=1 ;; esac # all zeros: a deletion, nothing to check
done

[ "$run_check" = 0 ] || scripts/task check
